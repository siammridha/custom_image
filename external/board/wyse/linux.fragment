# Boot / root
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_MODULES=y
CONFIG_FW_LOADER=y

# Storage: eMMC (3040), SATA/eMMC (5020), USB stick
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# Cherry Trail platform (3040)
CONFIG_X86_INTEL_LPSS=y
CONFIG_PINCTRL_CHERRYVIEW=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_DW_DMAC=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_BAYTRAIL=y
CONFIG_INTEL_SOC_PMIC=y
CONFIG_INTEL_SOC_PMIC_CHTWC=y
CONFIG_MFD_AXP20X_I2C=y
CONFIG_PMIC_OPREGION=y
CONFIG_CHT_WC_PMIC_OPREGION=y
CONFIG_XPOWER_PMIC_OPREGION=y

# No GPU drivers in the image (i915 is in the "kvm" driver pack). Screen
# console uses the firmware framebuffer (VGA text in BIOS mode, simpledrm
# in UEFI mode).
CONFIG_DRM=y
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Network
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_RTL8152=y
CONFIG_IPV6=y
CONFIG_TUN=y
CONFIG_WIREGUARD=y

# nftables for NetBird (firewall, routing peer / exit node NAT)
# and Tailscale. No iptables binary, so both use nftables.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_HASH=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_REJECT_IPV4=y
CONFIG_NFT_REJECT_IPV6=y

# Watchdog: the hardware reboots the device if the system freezes.
# 3040 = Intel iTCO (via LPC), 5020 = AMD SP5100 TCO, i6300esb = QEMU.
# softdog is a module, loaded only when no hardware watchdog was found.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_LPC_ICH=y
CONFIG_ITCO_WDT=y
CONFIG_ITCO_VENDOR_SUPPORT=y
CONFIG_SP5100_TCO=y
CONFIG_I6300ESB_WDT=y
CONFIG_SOFT_WATCHDOG=m

# Apps share one cgroup with a RAM limit (see /usr/libexec/wyse/apps-setup).
CONFIG_MEMCG=y

# Driver packs (see drivers/README). These drivers are built as modules
# with the kernel, then removed from the image by post-build.sh and
# shipped as packs that apps install into /data. Building them here keeps
# the small shared parts they need inside the kernel, so the packs always
# load into this exact kernel.

# Pack "sound": built-in sound (Cherry Trail + RT5672 codec, SOF driver)
# and USB sound cards.
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_ACPI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_BAYTRAIL=m
CONFIG_SND_SOC_INTEL_SST_TOPLEVEL=y
CONFIG_SND_SOC_INTEL_MACH=y
CONFIG_SND_SOC_INTEL_CHT_BSW_RT5672_MACH=m
# CONFIG_SND_SST_ATOM_HIFI2_PLATFORM_ACPI is not set
# CONFIG_SND_SST_ATOM_HIFI2_PLATFORM is not set
CONFIG_SND_USB_AUDIO=m

# Pack "kvm": GPU (Intel i915, for the VA-API H.264 encoder), USB capture
# cards (uvcvideo) and the CH9329 keyboard/mouse adapter (CH340 serial).
CONFIG_DRM_I915=m
# CONFIG_DRM_I915_CAPTURE_ERROR is not set
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CH341=m
