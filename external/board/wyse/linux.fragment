# Boot / root
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_MODULES=y
CONFIG_FW_LOADER=y

# Storage: eMMC, USB stick (SATA: 5020 only, in linux-5020.fragment)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# GPU drivers only for the model that uses one (3040: i915, in
# linux-3040.fragment and modules-3040). Screen console uses the firmware framebuffer (VGA text in BIOS mode, simpledrm
# in UEFI mode).
CONFIG_DRM=y
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Network
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_RTL8152=y
# CONFIG_IPV6 is not set
CONFIG_TUN=y
CONFIG_WIREGUARD=y

# nftables for NetBird (firewall, routing peer / exit node NAT)
# and Tailscale. No iptables binary, so both use nftables.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NFT_CT=y
# NetBird sets a conntrack mark on WireGuard traffic (ct mark set);
# NETFILTER_ADVANCED only makes the option selectable.
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK_MARK=y
# CONFIG_NF_CT_PROTO_SCTP is not set
# CONFIG_NF_CT_PROTO_UDPLITE is not set
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_HASH=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_IPV4=y

# Watchdog: the hardware reboots the device if the system freezes. The
# model's own watchdog driver is in linux-<model>.fragment; i6300esb = QEMU.
# softdog is a module, loaded only when no hardware watchdog was found.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_I6300ESB_WDT=y
CONFIG_SOFT_WATCHDOG=m

# Apps share one cgroup with a RAM limit (see /usr/libexec/wyse/apps-setup).
CONFIG_MEMCG=y

# Drivers for apps, built as modules for both models. post-build.sh keeps
# only the ones on the model's list (board/wyse/modules-<model>) in the
# image. Model-only drivers (built-in sound, GPU) are in
# linux-<model>.fragment.

# USB sound cards.
CONFIG_SND_USB_AUDIO=m

# USB capture cards (uvcvideo) and the CH9329 keyboard/mouse adapter (CH340
# serial).
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CH341=m

# Not used: turned on by x86_64_defconfig, which the kernel starts from.
# NFS (and booting from it)
# CONFIG_NFS_FS is not set
# CONFIG_ROOT_NFS is not set
# CONFIG_IP_PNP is not set
# Software RAID, device mapper
# CONFIG_MD is not set
# CONFIG_BLK_DEV_DM is not set
# Disk quotas
# CONFIG_QUOTA is not set
# CONFIG_QUOTACTL is not set
# Wi-Fi
# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_WLAN is not set
# CONFIG_RFKILL is not set
# Old IDE-style disk controllers
# CONFIG_ATA_SFF is not set
