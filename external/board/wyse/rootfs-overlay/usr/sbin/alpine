#!/bin/sh
# Run a command inside the Alpine folder (/data/alpine), as an app:
# low priority, first to be killed when RAM runs out, inside the apps
# cgroup. With no command: a shell.
#   alpine                     shell
#   alpine apk add alsa-lib    any command
A=/data/alpine
/sbin/wyse-init apps-setup || exit 1
echo $$ > /sys/fs/cgroup/apps/cgroup.procs
echo 500 > /proc/self/oom_score_adj
renice -n 10 -p $$ > /dev/null
cp /etc/resolv.conf /etc/hosts $A/etc/ 2>/dev/null
[ $# = 0 ] && set -- /bin/sh -l
exec chroot $A /usr/bin/env -i HOME=/root TERM="${TERM:-vt100}" \
	PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin "$@"
