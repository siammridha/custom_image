#!/bin/sh
# Set this device's host name: set-hostname [name]. Without a name it asks
# (Enter keeps the current one). Saved in /persist/hostname, which survives
# reboots and updates. NetBird and Tailscale use it too.
cur=$(cat /etc/hostname)
h=$1
while :; do
	if [ -z "$h" ]; then
		printf "Host name (short form, e.g. 'foo') [%s] " "$cur" >&2
		read -r h || exit 1
		h=${h:-$cur}
	fi
	echo "$h" | grep -qE '^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$' && break
	echo "Use letters, digits and '-' only (max 63, no '-' at the ends)." >&2
	[ -n "$1" ] && exit 1
	h=
done

echo "$h" > /persist/hostname
echo "Saved to /persist/hostname."

# The host name applies now. vpn-guard is restarted so NetBird and
# Tailscale take the new name too (NetBird reconnects once).
if [ "$h" != "$cur" ]; then
	/sbin/wyse-init hostname
	pkill -f "wyse-init run vpn-guard"
	echo "Host name is now $h. NetBird and Tailscale update in about 30 s."
fi
