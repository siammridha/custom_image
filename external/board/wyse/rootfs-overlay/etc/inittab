# /etc/inittab (BusyBox init)
#
# Startup: mounts, then wyse-init boot (persist folders, drivers,
# host name, network, SSH keys).
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/sbin/wyse-init boot

# Logs on /data (kept across reboots): at 512 KB messages becomes
# messages.0, so at most about 1 MB.
::respawn:/sbin/syslogd -n -O /data/log/messages -s 512 -b 1
::respawn:/sbin/klogd -n

# Remote access. init starts these after boot and starts them again
# whenever one exits.
::respawn:/sbin/wyse-init run watchdog
::respawn:/sbin/wyse-init run netbird
::respawn:/sbin/wyse-init run tailscaled
::respawn:/sbin/wyse-init run dropbear
::respawn:/sbin/wyse-init run ntpd
::respawn:/sbin/wyse-init run vpn-guard

# The Alpine subsystem: its own init and OpenRC start the apps (low
# priority, RAM-limited).
::respawn:/sbin/wyse-init run apps

# Before rebooting
::shutdown:/sbin/wyse-init stop-apps
::shutdown:/bin/umount -a -r
