# Dell Wyse 3040 (Intel Atom x5-Z8350) + Dell Wyse 5020 (AMD GX-415GA)
BR2_x86_64=y
BR2_x86_x86_64_v2=y

# Toolchain (built from source)
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# System
BR2_TARGET_GENERIC_HOSTNAME="localhost"
BR2_TARGET_GENERIC_ISSUE="wyse"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_SYSTEM_DHCP=""
# BR2_TARGET_GENERIC_GETTY is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_WYSE_PATH)/board/wyse/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_WYSE_PATH)/board/wyse/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_WYSE_PATH)/board/wyse/post-image.sh"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_WYSE_PATH)/board/wyse/busybox.fragment"

# Kernel (longterm)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.63"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_WYSE_PATH)/board/wyse/linux.fragment"
BR2_LINUX_KERNEL_BZIMAGE=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Driver firmware (Realtek network chips only)
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_815X=y

# Go built from source
BR2_PACKAGE_HOST_GO_SRC=y

# Network software
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_TAILSCALE=y
BR2_PACKAGE_NETBIRD=y
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set

# Disk tools for first-boot partition grow and overlay wipe
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_E2FSPROGS=y

# Root filesystem: read-only squashfs
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
# BR2_TARGET_ROOTFS_TAR is not set

# Boot loader: GRUB for both legacy BIOS and UEFI
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_BOOT_PARTITION="hd0,gpt1"
BR2_TARGET_GRUB2_BUILTIN_MODULES_PC="boot linux normal configfile biosdisk part_gpt fat echo test regexp probe"
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux normal configfile part_gpt fat echo test regexp probe efi_gop"

# Image tools
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_WYSE_PATH)/patches"
BR2_JLEVEL=3
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
