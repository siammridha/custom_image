# Settings shared by every device. Copy to config/network and fill in.
# Lines starting with # are comments.

# A server name and its IP, added to /etc/hosts on the device
static_host   = 203.0.113.10  sentryvault.example.com
# NetBird management URL (required)
netbird_url   = https://sentryvault.example.com:4478
# NetBird setup key
netbird_key   =
# Update server (raptor), the address devices use: http:// on its NetBird
# address and port. Built into the image. Empty: no automatic updates.
update_url       = http://172.22.0.10:8088
# The update server's web page and API on the local network, used by
# scripts/publish.sh (login in config/raptor)
update_admin_url = https://raptor.example.com
