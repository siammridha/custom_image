diff --git a/package/fakeroot/fakeroot.mk b/package/fakeroot/fakeroot.mk
index 12d7f1c4..0b23d672 100644
--- a/package/fakeroot/fakeroot.mk
+++ b/package/fakeroot/fakeroot.mk
@@ -15,6 +15,12 @@ HOST_FAKEROOT_DEPENDENCIES = host-acl
 HOST_FAKEROOT_CONF_ENV = \
 	ac_cv_header_sys_capability_h=no \
 	ac_cv_func_capset=no
+
+# musl build host (wyse): musl has no _STAT_VER, define it as 0 like
+# Alpine does; Alpine's patches are in the external tree and touch
+# configure.ac, so regenerate configure.
+HOST_FAKEROOT_AUTORECONF = YES
+HOST_FAKEROOT_CONF_ENV += CFLAGS="$(HOST_CFLAGS) -D_STAT_VER=0"
 FAKEROOT_LICENSE = GPL-3.0+
 FAKEROOT_LICENSE_FILES = COPYING
 
