diff --git a/package/mesa3d/mesa3d.mk b/package/mesa3d/mesa3d.mk
index f082d3c4..e57ba033 100644
--- a/package/mesa3d/mesa3d.mk
+++ b/package/mesa3d/mesa3d.mk
@@ -179,9 +179,14 @@ endif
 #   - Building OpenGL ES without OpenGL is not supported, so always keep opengl enabled.
 MESA3D_CONF_OPTS += -Dopengl=true
 
-# libva and mesa3d have a circular dependency
-# we do not need libva support in mesa3d, therefore disable this option
+# libva and mesa3d have a circular dependency only when libva is built
+# with GLX/X11 support. Without X11, enable VA-API in mesa3d (wyse).
+ifeq ($(BR2_PACKAGE_LIBVA)$(BR2_PACKAGE_XORG7),y)
+MESA3D_DEPENDENCIES += libva
+MESA3D_CONF_OPTS += -Dgallium-va=enabled -Dvideo-codecs=all
+else
 MESA3D_CONF_OPTS += -Dgallium-va=disabled
+endif
 
 # libGL is only provided for a full xorg stack, without libglvnd
 ifeq ($(BR2_PACKAGE_MESA3D_OPENGL_GLX),y)
