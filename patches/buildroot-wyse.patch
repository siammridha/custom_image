diff --git a/package/go/go-src/go-src.mk b/package/go/go-src/go-src.mk
index 7bdde1a8..561ef7c0 100644
--- a/package/go/go-src/go-src.mk
+++ b/package/go/go-src/go-src.mk
@@ -15,9 +15,18 @@ GO_SRC_CPE_ID_VENDOR = golang
 GO_SRC_CPE_ID_PRODUCT = go
 
 HOST_GO_SRC_PROVIDES = host-go
+ifeq ($(BR2_PACKAGE_HOST_GO_BOOTSTRAP_STAGE5_ARCH_SUPPORTS),y)
 HOST_GO_SRC_DEPENDENCIES = \
 	host-go-bootstrap-stage5 \
 	$(HOST_GO_DEPENDENCIES_CGO)
+HOST_GO_SRC_BOOTSTRAP_ROOT = $(HOST_GO_BOOTSTRAP_STAGE5_ROOT)
+else
+# No C bootstrap (go1.4) for this build host (e.g. aarch64): the host's
+# installed Go compiles this Go from source, like the host gcc compiles
+# the cross gcc.
+HOST_GO_SRC_DEPENDENCIES = $(HOST_GO_DEPENDENCIES_CGO)
+HOST_GO_SRC_BOOTSTRAP_ROOT = $(shell go env GOROOT 2>/dev/null)
+endif
 
 ifeq ($(BR2_PACKAGE_HOST_GO_TARGET_ARCH_SUPPORTS),y)
 
@@ -37,7 +46,7 @@ endif
