config/*
!config/README
!config/network.example
# Old places, so old copies are never committed.
.env
keys/*
root_ca.crt
# NetBird server config (setup key, relay secret, store key)
netbird_server_config/

# Build output and logs
build.log
drivers/out/
saved-states/
.DS_Store

# Claude session moved from the old project (may contain secrets)
.claude-transfer/
.claude/settings.local.json
