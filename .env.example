# Copy to .env and fill in. .env is git-ignored: these values are baked into
# the image at build time (external/board/wyse/post-build.sh), so keep the
# built images private too.

# Test device, used by scripts/deploy.sh
DEVICE_IP=192.168.80.13
# SSH key that logs in to the devices (make one: see keys/README)
SSH_KEY_FILE=keys/wyse_ed25519
# Its public half, allowed to log in as root
SSH_PUBLIC_KEY=ssh-ed25519 AAAA... wyse

# Tailscale auth key (backup VPN)
TAILSCALE_KEY=
# NetBird setup key (main VPN)
NETBIRD_KEY=
# Self-hosted NetBird server: its name and address (added to /etc/hosts).
# Management URL defaults to https://HOST_DOMAIN:4478; NETBIRD_URL overrides.
HOST_DOMAIN=
HOST_IP=
#NETBIRD_URL=

# File with the private root CA that signed the NetBird server's
# certificate (path relative to the repo; root_ca.crt is git-ignored).
ROOT_CA=root_ca.crt
